	<xsd:element name="vessel">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Air"/>
				<xsd:element ref="sea"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="volume">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="volumeValue"/>
				<xsd:element ref="unit"/>
				<xsd:element ref="height"/>
				<xsd:element ref="length"/>
				<xsd:element ref="width"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="voyage-no"/>
	<xsd:element name="width"/>
	<xsd:simpleType name="TRSServicePaidByType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="None"/>
			<xsd:enumeration value="Prepaid"/>
			<xsd:enumeration value="Collect"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="ExportDescriptionOfConsignment" type="xsd:string"/>
	<!-- SOX format datatypes where they difer from standard XSDL datatypes-->
	<xsd:simpleType name="xcblDate">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9]{4}(((01|03|05|07|08|10|12)((0[1-9])|([1-2][0-9])|(3[0-1])))|((04|06|09|11)((0[1-9])|([1-2][0-9])|30))|((02)((0[1-9])|([1-2][0-9]))))"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="xcblTime">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="((([0-1][0-9])|(2[0-3]))(:([0-5][0-9])){2}((\+|-)(([0-1][0-9])|(2[0-3])):([0-5][0-9]))?)"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="xcblDatetime">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9]{4}(((01|03|05|07|08|10|12)((0[1-9])|([1-2][0-9])|(3[0-1])))|((04|06|09|11)((0[1-9])|([1-2][0-9])|30))|((02)((0[1-9])|([1-2][0-9]))))T((([0-1][0-9])|(2[0-3]))(:([0-5][0-9])){2}((\+|-)(([0-1][0-9])|(2[0-3])):([0-5][0-9]))?)"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="xcblBoolean">
		<xsd:restriction base="xsd:boolean">
			<xsd:pattern value="true|false"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="xcblFloat">
		<xsd:restriction base="xsd:float">
			<xsd:pattern value="(\+|-)?[0-9]*\.?[0-9]*(E|e)?[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="xcblDouble">
		<xsd:restriction base="xsd:double">
			<xsd:pattern value="(\+|-)?[0-9]*\.?[0-9]*(E|e)?[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="NoteDetail" type="xsd:string"/>
	<xsd:element name="PackagingRefList">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PackageCode"/>
				<xsd:element ref="PackageTypeDescription"/>
				<xsd:element ref="NumberOfPackages"/>
				<xsd:element ref="ExportDescriptionOfConsignment"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:simpleType name="TRSBooleanYesNoType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Yes"/>
			<xsd:enumeration value="No"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="HazardousGoods" type="TRSBooleanYesNoType"/>
</xsd:schema>
