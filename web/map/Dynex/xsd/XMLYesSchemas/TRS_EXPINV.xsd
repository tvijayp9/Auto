			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AgencyCharges">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Applicable"/>
				<xsd:element ref="ServiceProvision"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
